{
  "name": "cli",
  "module": "./src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build --target bun ./src/index.tsx --outdir ./dist --external @opentui/core-darwin-x64 --external @opentui/core-darwin-arm64 --external @opentui/core-linux-x64 --external @opentui/core-linux-arm64 --external @opentui/core-linux-x64-musl --external @opentui/core-linux-arm64-musl --external @opentui/core-win32-arm64",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "bin": {
    "snow": "./bin/snow"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.34",
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.17",
    "ai": "^7.0.31",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.7",
    "react-router": "^8.2.0",
    "shared": "*",
    "zod": "^4.4.3"
  }
}
